# Copy to /etc/liquid-level-sender.env on the Raspberry Pi.
# Keep this file readable only by root and the sender service user.

HW_API_BASE=https://your-pythonanywhere-domain.example
HW_DEVICE_ID=hw-000123
HW_KEY_ID=v1
HW_DEVICE_SECRET=replace-with-the-provisioned-device-secret
FIRMWARE_VERSION=1.0.0

MODBUS_SERVER_IP=192.168.1.100
MODBUS_SERVER_PORT=504
MODBUS_UNIT_ID=1

# Set LIQUID_LEVEL_REGISTER when an analog level register exists.
# Leave it empty for a sensorless machine.
LIQUID_LEVEL_REGISTER=
LIQUID_RAW_MIN=0
LIQUID_RAW_MAX=4095

# Required when the PLC exposes a low-level digital coil, especially sensorless machines.
LIQUID_LOW_COIL=

READING_INTERVAL_SECONDS=300
READING_JITTER_SECONDS=30
LOG_LEVEL=INFO
