# Flask Backend Configuration
# Copy to .env and fill in your values

# Environment (development, production)
FLASK_ENV=development
FLASK_DEBUG=False

# Security - MUST be changed for production
SECRET_KEY=your-super-secret-key-change-this

# Database URL
# SQLite: sqlite:///backend.db
# PostgreSQL: postgresql://user:password@localhost:5432/backend
DATABASE_URL=sqlite:///backend.db

# Frontend URL for CORS
FRONTEND_ORIGIN=https://yourdomain.com

# Web Push (VAPID) - Generate with: python -c "from pywebpush import generate_keys; import json; k=generate_keys(); print(json.dumps(k))"
VAPID_PUBLIC_KEY=BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZJjSgSnfckjBJuBkr3qBUYIHBQFLXYp5Nksh8U
VAPID_PRIVATE_KEY=your-private-key-here
VAPID_ADMIN_EMAIL=admin@example.com

# Device secrets for machines - Set via database.py or admin
# Format: hw-000123:v1:super-secret-key
